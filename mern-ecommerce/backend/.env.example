NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/yanoben
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=8h
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CLIENT_URLS=http://localhost:3000,http://localhost:5174
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
# Set to the number of trusted reverse-proxy hops, never blindly to true.
TRUST_PROXY_HOPS=0
# For split hosting: the API origin, e.g. https://api.your-domain.tld
API_PUBLIC_URL=
# Optional absolute path on a persistent mounted volume. Back it up with MongoDB.
UPLOAD_DIR=

# Set ALL three variables on the backend to enable signed Cloudinary uploads.
# Keep API_SECRET only on the backend, never in frontend build variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
