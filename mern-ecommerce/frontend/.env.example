# Leave empty for same-origin /api (recommended integrated deployment).
REACT_APP_API_URL=
REACT_APP_SOCKET_URL=
# Development defaults to http://localhost:5174/admin/login.
# Production defaults to /admin/login.
REACT_APP_ADMIN_URL=
# Development server binds to loopback unless HOST is explicitly set.
HOST=127.0.0.1
