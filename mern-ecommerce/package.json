{
  "name": "mern-ecommerce",
  "version": "1.1.0",
  "private": true,
  "description": "MERN E-Commerce Platform (YANOVA)",
  "scripts": {
    "setup": "node scripts/setup-env.cjs",
    "install:all": "node scripts/install.cjs",
    "server": "npm run dev --prefix backend",
    "client": "npm start --prefix frontend",
    "admin": "npm run dev --prefix admin",
    "dev": "concurrently \"npm run server\" \"npm run client\" \"npm run admin\"",
    "build": "node scripts/build.cjs",
    "start": "npm start --prefix backend",
    "test": "npm test --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
